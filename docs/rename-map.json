  "overridden": {
    "logo": "sds-header-logo",
    "name": "sds-header-name",
    "role": "sds-header-role",
    "bar": "sds-menu-bar"
  },
  "ids": {
    "global-header": "sds-global-header",
    "global-footer": "sds-global-footer",
    "main-nav": "sds-main-nav",
    "menu-trigger": "sds-menu-trigger",
    "theme-toggle": "sds-theme-toggle",
    "theme-color-light": "sds-theme-color-light",
    "theme-color-dark": "sds-theme-color-dark"
  },
  "customProperties": {
    "rule": "Every custom property --x becomes --sds-x (primitives, semantic tokens, component hooks, JS-set vars). Applies to declarations, var() calls, inline style attributes, and style.setProperty().",
    "examples": {
      "--color-text": "--sds-color-text",
      "--l-50": "--sds-l-50",
      "--brackets": "--sds-brackets",
      "--logo-card-ratio": "--sds-logo-card-ratio",
      "--color-header-bg": "--sds-color-header-bg",
      "--outside-grid-dark-clip": "--sds-outside-grid-dark-clip"
    },
    "exclude": [
      "--prev",
      "--next",
      "--natural"
    ],
    "excludeNote": "Prose mentions of BEM modifiers in comments (pagination-link--prev, image-block-media--natural), not custom properties."
  },
  "attributes": {
    "data-theme": "data-sds-theme",
    "data-tooltip": "data-sds-tooltip",
    "data-tooltip-position": "data-sds-tooltip-position",
    "data-placement": "data-sds-placement",
    "dataset.tooltip": "dataset.sdsTooltip",
    "dataset.tooltipPosition": "dataset.sdsTooltipPosition",
    "dataset.placement": "dataset.sdsPlacement"
  },
  "events": {
    "sectionchange": "sds:sectionchange"
  },
  "storage": {
    "theme": "sds-theme",
    "note": "Needs a one-time fallback read of the legacy 'theme' key so the portfolio keeps its saved preference. github.io projects share one origin, so an unprefixed key can collide across sites."
  },
  "notRenamed": {
    "idsSectionSelectors": [
      "work",
      "about",
      "contact",
      "related-work",
      "logos",
      "hero",
      "page-hero"
    ],
    "note": "Section-id selectors are decoupled by hand (see docs/PHASE-2.md), not renamed.",
    "keep": [
      "#root (reset.css)",
      "aria-* attributes",
      "bare element selectors (h1, p, img...)"
    ]
  },
  "manualFollowUps": [
    "theme.js builds `.morph-ray-${i}` dynamically",
    "global-header.css and animations.css use [class^=\"morph-ray-\"]; ^= only matches when it is the FIRST class, so switch to [class*=\"sds-morph-ray-\"]",
    "nav-underline.js injects a <style> block containing .no-underline-transition",
    "contact-form.js queries #contact-name / #contact-email / #contact-message / #contact-submit-error (host-owned ids)",
    "Comments/strings that build custom-property names from a prefix (animations.css:26 `--padding-`/`--adaptive-space-`, typography.css:272 `--font-size-`, theme.js:160 `--color-background-accent-`) must be updated by hand"
  ],
  "removed": {
    "subpage": "replaced by opt-in .sds-scale-display (heading tokens); see typography.css",
    "profile-link": "portfolio-only component; stays in the portfolio"
  },
  "added": {
    "sds-scale-display": "remaps --sds-heading-N to --sds-display-N"
  }
}
